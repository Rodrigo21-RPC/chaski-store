# Copia este archivo como .env y completa tus propios valores.
# El archivo .env nunca se sube al repositorio.

# Clave del administrador de la tienda (obligatoria).
ADMIN_PASSWORD=

# Número de WhatsApp de la tienda (obligatorio): solo dígitos con código de país,
# sin "+" ni espacios. Ejemplo de formato: 51 seguido de los 9 dígitos del celular.
WHATSAPP_NUMBER=

# Puerto donde corre la tienda (opcional). Si lo dejas vacío se usa 3000.
PORT=
